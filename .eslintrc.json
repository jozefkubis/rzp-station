// .eslintrc.json
{
  "root": true,
  "env": { "browser": true, "es2021": true, "node": true },
  "plugins": ["react", "react-hooks"],
  "extends": [
    "eslint:recommended",
    "plugin:@next/next/recommended",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "settings": {
    "react": { "version": "detect" }
  },
  "rules": {
    "no-unused-vars": "warn",
    "react/jsx-uses-vars": "warn",
    "no-irregular-whitespace": [
      "error",
      {
        "skipComments": true,
        "skipJSXText": true,
        "skipStrings": true,
        "skipTemplates": true
      }
    ]
  }
}
