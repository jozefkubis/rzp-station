// .eslintrc.json
{
  "root": true,
  "env": { "browser": true, "es2021": true, "node": true },
  "extends": [
    "eslint:recommended",
    "plugin:@next/next/recommended",
    "plugin:prettier/recommended"
  ],
  "parserOptions": { "ecmaVersion": 13, "sourceType": "module" },
  "rules": {
    "no-unused-vars": "warn"
  }
}
